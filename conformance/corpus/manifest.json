  "tiers": {
    "F": {
      "title": "Format & integrity",
      "engineAgnostic": true,
      "invariants": "invariants.json",
      "runner": "../harness/format_suite.py"
    },
    "C": {
      "title": "Canonicalisation + audit chain (byte-for-byte)",
      "runsThroughAdapter": true,
      "query": "verify-chain",
      "expect": { "ok": true, "badRows": [] },
      "appliesTo": ["*"],
      "note": "Adapter recomputes sha256(canonicalJson({v:2,...})) for every audit row and walks the chain; MUST report ok:true with zero bad rows. auditRows in each case pins the expected row count."
    },
    "R": {
      "title": "Report golden outputs (byte-for-byte)",
      "runsThroughAdapter": true,
      "fixturesDir": "fixtures",
      "fixturePath": "fixtures/{case}/{query}.json",
      "queries": [
        {
          "name": "trial-balance",
          "appliesTo": ["*"],
          "desc": "Per-account aggregation over entry_lines: [{account_id, name, type, debit, credit}] for every account with postings, sorted by account_id. Paise integers. `name` reads the frozen entry_lines.account_name (Invariant 7) falling back to accounts.name."
        },
        {
          "name": "account-type-totals",
          "appliesTo": ["*"],
          "desc": "Debit/credit totals grouped by account type: [{type, debit, credit}] sorted by type. Paise integers."
        },
        {
          "name": "gst-outward-summary",
          "appliesTo": ["*"],
          "desc": "Outward-supply GST totals from posted invoices: {invoice_count, taxable, cgst, sgst, igst, cess}. Paise integers."
        },
        {
          "name": "stock-on-hand",
          "appliesTo": ["*"],
          "desc": "Per-item closing quantity from stock_movements (in − out): [{item_id, item_name, on_hand_qty}] sorted by item_id. Empty array for services-only cases."
        }
      ]
    }
  },
  "adapter": {
    "contract": "../adapters/README.md",
    "invocation": "<adapter...> <query> <path-to.khata>",
    "output": "canonical JSON on stdout, exit 0",
    "reference": "../adapters/js/adapter.mjs",
    "queries": ["verify-chain", "trial-balance", "account-type-totals", "gst-outward-summary", "stock-on-hand"]
  }
}
