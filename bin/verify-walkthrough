#!/usr/bin/env ruby

APP_ROOT = File.expand_path("..", __dir__)
SYSTEM_TESTS = %w[
  test/system/walkthrough_test.rb
].freeze
FAST_TESTS = %w[
  test/integration/walkthrough_role_matrix_test.rb
  test/integration/authentication_flow_test.rb
  test/integration/onboarding_flow_test.rb
  test/integration/browser_product_flow_test.rb
  test/integration/purchase_bill_flows_test.rb
  test/integration/sales_invoice_flows_test.rb
  test/integration/api/v1/documents_api_test.rb
  test/integration/api/v1/tenant_isolation_test.rb
  test/jobs/onboarding_delivery_jobs_test.rb
  test/models/onboarding_test.rb
  test/models/onboarding_concurrency_test.rb
  test/models/rbac_test.rb
  test/models/settlement_test.rb
  test/models/open_item_reports_test.rb
  test/models/posting/period_control_test.rb
  test/models/financial_statements_report_test.rb
].freeze

Dir.chdir(APP_ROOT)
rails = File.join(APP_ROOT, "bin/rails")
abort "Browser walkthrough failed" unless system({ "PARALLEL_WORKERS" => "1" }, rails, "test", *SYSTEM_TESTS)

exec rails, "test", *FAST_TESTS
