#!/bin/bash
set -euo pipefail

: "${FOLIO_RELEASE_DATABASE_URL:?set FOLIO_RELEASE_DATABASE_URL}"
: "${FOLIO_RELEASE_QUEUE_DATABASE_URL:?set FOLIO_RELEASE_QUEUE_DATABASE_URL}"
: "${FOLIO_RELEASE_CACHE_DATABASE_URL:?set FOLIO_RELEASE_CACHE_DATABASE_URL}"

export DATABASE_URL="$FOLIO_RELEASE_DATABASE_URL"
export QUEUE_DATABASE_URL="$FOLIO_RELEASE_QUEUE_DATABASE_URL"
export CACHE_DATABASE_URL="$FOLIO_RELEASE_CACHE_DATABASE_URL"

exec bin/rails db:prepare
