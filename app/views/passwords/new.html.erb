<% content_for :title, "Reset password · Folio" %>

<main id="main-content" class="public-form-shell public-form-shell--centered">
  <section class="panel form-panel public-form-card">
    <p class="eyebrow">Account recovery</p>
    <h1>Forgot your password?</h1>
    <p>Enter your Folio email and we’ll send a time-limited reset link if the account exists.</p>
    <%= form_with url: password_path, class: "stacked-form" do |form| %>
      <div class="form-group">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
      </div>
      <%= form.submit "Email reset instructions", class: "button button--primary button--full" %>
    <% end %>
    <p class="auth-card__footer"><%= link_to "Back to sign in", new_session_path %></p>
  </section>
</main>
