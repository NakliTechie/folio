<% content_for :title, "Choose a new password · Folio" %>

<main id="main-content" class="public-form-shell public-form-shell--centered">
  <section class="panel form-panel public-form-card">
    <p class="eyebrow">Account recovery</p>
    <h1>Choose a new password</h1>
    <p>Enter the new password twice to protect against typing mistakes.</p>
    <%= form_with url: password_path(params[:token]), method: :put, class: "stacked-form" do |form| %>
      <div class="form-group">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true,
          autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="form-group">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true,
          autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit "Save new password", class: "button button--primary button--full" %>
    <% end %>
  </section>
</main>
