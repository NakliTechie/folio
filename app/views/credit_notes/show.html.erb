<% content_for :title, "#{@document.document_number || "Draft credit note"} · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= link_to "← Back to credit notes", credit_notes_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading">
    <div><p class="eyebrow">Credit note</p><h1><%= @document.document_number || "Draft credit note" %></h1>
      <p>For invoice <%= link_to @document.credit_note_for.document_number,
        sales_invoice_path(@document.credit_note_for, tenant_route_options) %> · <%= credit_note_reason_label(@document.reason_code) %></p></div>
    <span class="<%= status_class(@document.state) %>"><%= @document.state.humanize %></span>
  </header>

  <section class="panel voucher-card">
    <dl class="metadata-grid">
      <div><dt>Credit-note date</dt><dd><%= @document.document_date.to_fs(:long) %></dd></div>
      <div><dt>Invoice date</dt><dd><%= @document.credit_note_for.document_date.to_fs(:long) %></dd></div>
      <div><dt>Customer</dt><dd><%= @document.party_snapshot.fetch("name") %></dd></div>
      <div><dt>Customer GSTIN</dt><dd><%= @document.party_snapshot.fetch("gstin") %></dd></div>
    </dl>
    <div class="table-wrap"><table>
      <caption class="sr-only">Credit-note lines</caption>
      <thead><tr><th scope="col">Service</th><th scope="col">SAC</th><th scope="col">Quantity</th>
        <th scope="col">GST rate</th><th scope="col">Taxable credit</th></tr></thead>
      <tbody>
        <% @document.document_lines.each do |line| %>
          <tr><td><strong><%= line.item_snapshot.fetch("name") %></strong></td><td><%= line.hsn_sac_code %></td>
            <td><%= line.quantity.to_s("F") %> <%= line.item_snapshot.fetch("unitOfMeasure") %></td>
            <td><%= basis_points_percentage(line.tax_rate_basis_points) %></td>
            <td class="money"><%= money_amount(line.taxable_minor, currency: @document.currency) %></td></tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr><th scope="row" colspan="4">Taxable credit</th><td class="money"><%= money_amount(@document.subtotal_minor, currency: @document.currency) %></td></tr>
        <% @document.tax_breakdown.sort.each do |component, amount| %>
          <tr><th scope="row" colspan="4"><%= component.upcase %></th><td class="money"><%= money_amount(amount, currency: @document.currency) %></td></tr>
        <% end %>
        <tr><th scope="row" colspan="4">Total credit</th><td class="money"><strong><%= money_amount(@document.total_minor, currency: @document.currency) %></strong></td></tr>
      </tfoot>
    </table></div>
  </section>

  <% if @document.postable? %>
    <section class="panel posting-panel">
      <div><p class="eyebrow">Accounting preview</p><h2><%= @simulation[:balanced] ? "Balanced and ready to post" : "This credit note does not balance" %></h2>
        <p>Posting creates a separate statutory number and applies the credit to both receivable open-item sides.</p></div>
      <% if @simulation[:balanced] && permitted?("invoices.create") %>
        <%= button_to "Post credit note", post_credit_note_path(@document, tenant_route_options),
          method: :post, class: "button button--primary" %>
      <% end %>
    </section>
  <% else %>
    <div class="action-row">
      <% if @document.statutory_printable? %>
        <%= link_to "Print credit note", print_credit_note_path(@document, tenant_route_options), class: "button button--primary" %>
      <% end %>
      <%= link_to "Open source invoice", sales_invoice_path(@document.credit_note_for, tenant_route_options), class: "button button--secondary" %>
    </div>
  <% end %>
</main>
