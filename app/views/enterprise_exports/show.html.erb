<% content_for :title, "Enterprise exports · Folio" %>

<main id="main-content" class="page-shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Migration</p>
      <h1>Enterprise exports</h1>
      <p>Create a balanced, checksummed SAP Business One DTW package from verified books.</p>
    </div>
  </div>

  <section class="card">
    <h2>SAP Business One DTW</h2>
    <p class="muted">Each ZIP contains chart-of-accounts and business-partner masters, journal headers and lines, Folio crosswalks, source-event hashes, and a SHA-256 manifest. Validate it against templates generated by the exact target SAP B1 version before importing.</p>

    <%= form_with url: sap_b1_dtw_enterprise_export_path, method: :get, class: "form-grid" do |form| %>
      <div class="form-group">
        <%= form.label :scope, "Export scope" %>
        <%= form.select :scope, [["Legal entity", "entity"], ["Office", "office"], ["Consolidated group", "group"]] %>
      </div>
      <div class="form-group">
        <%= form.label :entity_id, "Legal entity (entity scope)" %>
        <%= form.select :entity_id, @entities.map { |entity| ["#{entity.code} · #{entity.legal_name}", entity.id] }, include_blank: true %>
      </div>
      <div class="form-group">
        <%= form.label :office_id, "Office (office scope)" %>
        <%= form.select :office_id, @offices.map { |office| ["#{office.entity.code} / #{office.code} · #{office.name}", office.id] }, include_blank: true %>
      </div>
      <div class="form-group">
        <%= form.label :group_id, "Group (consolidated scope)" %>
        <%= form.select :group_id, @groups.map { |group| ["#{group.code} · #{group.name}", group.id] }, include_blank: true %>
      </div>
      <div class="form-group">
        <%= form.label :from_date, "From" %>
        <%= form.date_field :from_date, value: business_date.beginning_of_year, required: true %>
      </div>
      <div class="form-group">
        <%= form.label :to_date, "To" %>
        <%= form.date_field :to_date, value: business_date, required: true %>
      </div>
      <div class="form-actions">
        <%= form.submit "Download DTW package", class: "button" %>
      </div>
    <% end %>
  </section>
</main>
