<% content_for :title, "Enterprise exports · Folio" %>

<main id="main-content" class="page-shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Migration</p>
      <h1>Enterprise exports</h1>
      <p>Move verified books without surrendering their accounting or audit evidence.</p>
    </div>
  </div>

  <section class="card">
    <h2>SAP Business One DTW</h2>
    <p class="muted">Each ZIP contains chart-of-accounts and business-partner masters, journal headers and lines, Folio crosswalks, source-event hashes, and a SHA-256 manifest. Validate it against templates generated by the exact target SAP B1 version before importing.</p>

    <%= form_with url: sap_b1_dtw_enterprise_export_path, method: :get, class: "form-grid" do |form| %>
      <div class="form-group">
        <%= form.label :scope, "Export scope" %>
        <%= form.select :scope, [["Legal entity", "entity"], ["Office", "office"], ["Consolidated group", "group"]] %>
      </div>
      <div class="form-group">
        <%= form.label :entity_id, "Legal entity (entity scope)" %>
        <%= form.select :entity_id, @entities.map { |entity| ["#{entity.code} · #{entity.legal_name}", entity.id] }, include_blank: true %>
      </div>
      <div class="form-group">
        <%= form.label :office_id, "Office (office scope)" %>
        <%= form.select :office_id, @offices.map { |office| ["#{office.entity.code} / #{office.code} · #{office.name}", office.id] }, include_blank: true %>
      </div>
      <div class="form-group">
        <%= form.label :group_id, "Group (consolidated scope)" %>
        <%= form.select :group_id, @groups.map { |group| ["#{group.code} · #{group.name}", group.id] }, include_blank: true %>
      </div>
      <div class="form-group">
        <%= form.label :from_date, "From" %>
        <%= form.date_field :from_date, value: business_date.beginning_of_year, required: true %>
      </div>
      <div class="form-group">
        <%= form.label :to_date, "To" %>
        <%= form.date_field :to_date, value: business_date, required: true %>
      </div>
      <div class="form-actions">
        <%= form.submit "Download DTW package", class: "button" %>
      </div>
    <% end %>
  </section>

  <section class="card">
    <h2>Open .khata copy</h2>
    <p class="muted">Download a standard `.khata` v1/schema 12 archive containing the chart, double-entry projection, and exact ledger chain. Export fails closed when the selected company uses Folio features that v1 cannot represent safely.</p>

    <%= form_with url: khata_enterprise_export_path, method: :post, class: "form-grid" do |form| %>
      <div class="form-group">
        <%= form.label :entity_id, "Legal company" %>
        <%= form.select :entity_id, @entities.map { |entity| ["#{entity.code} · #{entity.legal_name}", entity.id] }, required: true %>
      </div>
      <div class="form-actions">
        <%= form.submit "Download .khata", class: "button" %>
      </div>
    <% end %>
  </section>

  <% if permitted?("khata.import") %>
    <section class="card">
      <h2>Import existing Bahi books</h2>
      <% if @khata_import %>
        <p class="notification notification--success">Imported <strong><%= @khata_import.source_filename %></strong> once. <%= @khata_import.source_audit_rows %> signed audit rows reproduce head <code><%= @khata_import.source_audit_head.first(12) %>…</code>; bounded runtime-format checks, target recovery, and native account-report parity passed.</p>
        <% @khata_import.conformance.dig("identity", "warnings").to_a.each do |warning| %>
          <p class="notification notification--warning"><%= warning %></p>
        <% end %>
      <% elsif @khata_import_upload&.status.in?(%w[queued processing]) %>
        <p class="notification notification--info"><strong><%= @khata_import_upload.source_filename %></strong> is <%= @khata_import_upload.status %>. Refresh this page for the verified result.</p>
      <% else %>
        <% if @khata_import_upload&.status == "failed" %>
          <p class="notification notification--warning">The previous import failed: <%= @khata_import_upload.error_message %></p>
        <% end %>
        <p class="muted">For a newly created, operationally empty company only. Folio verifies safe ZIP structure, bounded SQLite integrity checks, posting-event correspondence, every audit-chain link and signature, a governed recovery snapshot, and native account-report parity before committing anything. This runtime gate is narrower than the release-only Tier F/C/R corpus suite. The import is a one-time server-authoritative migration, not an offline merge.</p>
        <%= form_with url: import_khata_enterprise_export_path, method: :post, multipart: true, class: "form-grid" do |form| %>
          <div class="form-group">
            <%= form.label :khata_file, ".khata file" %>
            <%= form.file_field :khata_file, accept: ".khata,application/x-khata,application/zip", required: true %>
          </div>
          <div class="form-actions">
            <%= form.submit "Queue verification and import", class: "button" %>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>
</main>
