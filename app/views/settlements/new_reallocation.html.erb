<% content_for :title, "Reallocate unapplied cash · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell page-shell--narrow">
  <%= link_to "← Back to #{@document.document_number}", settlement_path(@document, tenant_route_options), class: "back-link" %>
  <header class="page-heading page-heading--stacked">
    <p class="eyebrow">Correct an allocation</p>
    <h1>Reallocate unapplied cash</h1>
    <p>Move <%= money_amount(@allocation.amount_minor, currency: @document.currency) %> to one eligible open item for <%= @document.party_snapshot.fetch("name") %>.</p>
  </header>

  <section class="panel form-panel">
    <%= form_with scope: :reallocation,
      url: settlement_reallocation_path(@document, allocation_id: @allocation.id, **tenant_route_options),
      class: "stacked-form" do |form| %>
      <div class="form-group">
        <%= form.label :target_entry_line_id, "New open item" %>
        <%= form.select :target_entry_line_id,
          @open_items.map { |item| [
            "#{item.entry.document&.document_number || item.assignment} · #{money_amount(Posting::Clearing.open_amount(item))}", item.id
          ] },
          { prompt: "Choose an open item" }, required: true %>
      </div>
      <div class="form-group">
        <%= form.label :clearing_mode, "Remaining-balance treatment" %>
        <%= form.select :clearing_mode,
          [["Preserve ageing", "partial"], ["Reset ageing", "residual"]], {}, required: true %>
      </div>
      <p class="table-note">This first correction flow reapplies the complete unapplied amount to one item. Split reallocation requires a separately numbered allocation document.</p>
      <div class="form-actions">
        <%= form.submit "Apply reallocation", class: "button button--primary", disabled: @open_items.empty? %>
        <%= link_to "Cancel", settlement_path(@document, tenant_route_options), class: "button button--quiet" %>
      </div>
    <% end %>
  </section>
</main>
