<% content_for :title, "#{@document.document_number || "Draft bill"} · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= link_to "← Back to purchase bills", purchase_bills_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow">B2B purchase bill</p>
      <h1><%= @document.document_number || "Draft bill" %></h1>
      <p><%= @document.party_snapshot.fetch("name") %> · Supplier invoice <%= @document.external_reference.presence || "—" %></p>
    </div>
    <span class="<%= status_class(@document.state) %>"><%= @document.state.humanize %></span>
  </header>

  <section class="panel voucher-card">
    <dl class="metadata-grid">
      <div><dt>Supplier invoice</dt><dd><%= @document.external_reference.presence || "—" %></dd></div>
      <div><dt>Invoice date</dt><dd><%= @document.document_date.to_fs(:long) %></dd></div>
      <div><dt>Due date</dt><dd><%= @document.due_date.to_fs(:long) %></dd></div>
      <div><dt>Vendor GSTIN</dt><dd><%= @document.party_snapshot.fetch("gstin") %></dd></div>
      <div><dt>Buyer GSTIN</dt><dd><%= @document.tax_registration_snapshot.fetch("identifier") %></dd></div>
      <div><dt>Place of supply</dt><dd><%= Taxes::India::StateCodes.name_for(@document.place_of_supply_state_code) %> (<%= @document.place_of_supply_state_code %>)</dd></div>
    </dl>

    <div class="table-wrap">
      <table>
        <caption class="sr-only">Frozen purchase bill lines and input-GST calculation</caption>
        <thead><tr><th scope="col">Expense</th><th scope="col">HSN/SAC</th><th scope="col">Quantity</th>
          <th scope="col">Unit price</th><th scope="col">GST rate</th><th scope="col">Taxable</th></tr></thead>
        <tbody>
          <% @document.document_lines.each do |line| %>
            <tr>
              <td><strong><%= line.item_snapshot.fetch("name") %></strong><br><small><%= line.item_snapshot.fetch("code") %></small></td>
              <td><%= line.hsn_sac_code %></td>
              <td><%= line.quantity.to_s("F") %> <%= line.item_snapshot.fetch("unitOfMeasure") %></td>
              <td class="money"><%= money_amount(line.unit_price_minor, currency: @document.currency) %></td>
              <td><%= basis_points_percentage(line.tax_rate_basis_points) %></td>
              <td class="money"><%= money_amount(line.taxable_minor, currency: @document.currency) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr><th scope="row" colspan="5">Subtotal</th><td class="money"><%= money_amount(@document.subtotal_minor, currency: @document.currency) %></td></tr>
          <% @document.tax_breakdown.sort.each do |component, amount| %>
            <tr><th scope="row" colspan="5"><%= component.upcase %> input credit</th><td class="money"><%= money_amount(amount, currency: @document.currency) %></td></tr>
          <% end %>
          <tr><th scope="row" colspan="5">Bill total</th><td class="money"><strong><%= money_amount(@document.total_minor, currency: @document.currency) %></strong></td></tr>
        </tfoot>
      </table>
    </div>
  </section>

  <% if @document.postable? %>
    <section class="panel posting-panel">
      <div>
        <p class="eyebrow">Accounting preview</p>
        <h2><%= @simulation[:balanced] ? "Input GST calculated and ready to post" : "This bill does not balance" %></h2>
        <p>Posting debits the expense and input-GST accounts and credits an open vendor payable. The frozen bill becomes immutable afterward.</p>
      </div>
      <% if @simulation[:balanced] && permitted?("bills.create") %>
        <%= button_to "Post bill", post_purchase_bill_path(@document, tenant_route_options),
          method: :post, class: "button button--primary" %>
      <% end %>
    </section>
  <% else %>
    <div class="action-row">
      <%= link_to "View reports", reports_path(tenant_route_options), class: "button button--primary" if permitted?("reports.read") %>
      <% if @document.reversible? && permitted?("documents.reverse") %>
        <%= button_to "Reverse bill", reverse_purchase_bill_path(@document, tenant_route_options),
          method: :post, class: "button button--danger",
          form: { data: { turbo_confirm: "Reverse this unsettled bill with a compensating entry?" } } %>
      <% end %>
    </div>
  <% end %>
</main>
