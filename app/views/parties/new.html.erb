<% content_for :title, "Add party · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell page-shell--narrow">
  <%= link_to "← Back to customers & vendors", parties_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading page-heading--stacked">
    <p class="eyebrow">Masters</p>
    <h1>Add a customer or vendor</h1>
    <p>Keep one identity per real counterparty, then assign every role it performs.</p>
  </header>
  <section class="panel form-panel">
    <%= render "form", party: @party, form_url: parties_path(tenant_route_options), submit_label: "Add party" %>
  </section>
</main>
