<% content_for :title, "Chart of accounts · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Masters</p>
      <h1>Chart of accounts</h1>
      <p>Stable account codes used by vouchers and reports for <%= Current.tenant.name %>.</p>
    </div>
    <div class="action-row">
      <% if permitted?("accounts.manage") && permitted?("documents.post") %>
        <%= link_to "Opening balances", opening_balances_path(tenant_route_options), class: "button button--secondary" %>
      <% end %>
      <% if permitted?("accounts.manage") %>
        <%= link_to "Add account", new_account_path(tenant_route_options), class: "button button--primary" %>
      <% end %>
    </div>
  </header>

  <section class="panel panel--table">
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Accounts for <%= Current.tenant.name %></caption>
        <thead>
          <tr><th scope="col">Code</th><th scope="col">Account</th><th scope="col">Type</th>
            <th scope="col">Status</th><th scope="col"><span class="sr-only">Action</span></th></tr>
        </thead>
        <tbody>
          <% @accounts.each do |account| %>
            <tr>
              <td><span class="account-code"><%= account.code %></span></td>
              <td><strong><%= account.name %></strong></td>
              <td><span class="status-badge"><%= account.account_type.humanize %></span></td>
              <td><span class="<%= account.active? ? "status-badge status-badge--success" : "status-badge" %>">
                <%= account.active? ? "Active" : "Inactive" %></span></td>
              <td><% if permitted?("accounts.manage") %>
                <%= link_to "Edit", edit_account_path(account, tenant_route_options), class: "text-link" %>
              <% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
