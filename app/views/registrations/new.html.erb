<main>
  <h1>Create your Folio account</h1>
  <%= form_with url: registration_path, method: :post do |f| %>
    <%= f.label :org_name, "Company name" %><%= f.text_field :org_name, required: true, value: params[:org_name] %>
    <%= f.label :email_address, "Email" %><%= f.email_field :email_address, required: true, autocomplete: "username", value: params[:email_address] %>
    <%= f.label :password %><%= f.password_field :password, required: true, autocomplete: "new-password" %>
    <%= f.submit "Create account" %>
  <% end %>
  <p>Already have an account? <%= link_to "Sign in", new_session_path %></p>
</main>
