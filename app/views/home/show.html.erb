<% content_for :title, "Overview · #{Current.tenant.name} · Folio" %>
<% verification_required = Rails.application.config.x.email_verification_required %>
<% verification_blocks_changes = verification_required && !Current.user.verified? %>
<% completed_setup_steps = 2 + (Current.user.verified? ? 1 : 0) + (@journal_posted_count.positive? ? 1 : 0) %>

<main id="main-content" class="page-shell">
  <section class="overview-hero">
    <div>
      <p class="eyebrow"><%= Current.tenant.name %> · <%= role_name %></p>
      <h1>Your books, at a glance</h1>
      <p class="lede">Signed in as <%= Current.user.email_address %>. Keep the setup moving or pick up where your team left off.</p>
      <div class="action-row">
        <% if permitted?("documents.post") && verification_blocks_changes %>
          <%= link_to "Verify email before recording", "#email-verification", class: "button button--primary" %>
        <% elsif permitted?("documents.post") %>
          <%= link_to @journal_posted_count.zero? ? "Choose your first business event" : "Record a business event",
            new_journal_voucher_path(tenant_route_options), class: "button button--primary" %>
        <% end %>
        <% if permitted?("reports.read") %>
          <%= link_to "View trial balance", reports_path(tenant_route_options), class: "button button--secondary" %>
        <% end %>
      </div>
    </div>
    <div class="hero-summary" aria-label="Accounting profile">
      <span class="hero-summary__label">Accounting profile</span>
      <strong><%= Onboarding::AccountingProfile::JURISDICTIONS.fetch(@entity.jurisdiction_profile) %></strong>
      <span><%= Current.tenant.functional_currency %> · <%= Onboarding::AccountingProfile::FISCAL_YEARS.fetch(@entity.fiscal_year_variant) %></span>
    </div>
  </section>

  <section class="metric-grid" aria-label="Company summary">
    <article class="metric-card">
      <span class="metric-card__label">Accounts</span>
      <strong><%= @accounts_count %></strong>
      <%= link_to "Open chart", accounts_path(tenant_route_options) %>
    </article>
    <article class="metric-card">
      <span class="metric-card__label">Posted documents</span>
      <strong><%= @posted_count %></strong>
      <%= link_to "View transactions", journal_vouchers_path(tenant_route_options) %>
    </article>
    <article class="metric-card">
      <span class="metric-card__label">Email</span>
      <strong><%= Current.user.verified? ? "Verified" : delivery_state_label(Current.user.verification_delivery_state) %></strong>
      <span class="metric-card__hint"><%= if Current.user.verified?
        verification_required ? "Required identity step complete" : "Account recovery is ready"
      elsif verification_required
        "Required before company changes"
      else
        "Optional; enables dependable recovery"
      end %></span>
    </article>
  </section>

  <div class="content-grid">
    <section class="panel">
      <div class="panel__header">
        <div>
          <p class="eyebrow">First run</p>
          <h2>Setup checklist</h2>
        </div>
        <span class="progress-count"><%= completed_setup_steps %>/4</span>
      </div>
      <ol class="checklist">
        <li class="checklist__item checklist__item--done">
          <span aria-hidden="true">✓</span>
          <div><strong>Company created</strong><small><%= @entity.legal_name %></small></div>
        </li>
        <li class="checklist__item checklist__item--done">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Starter chart created</strong><small><%= @accounts_count %> accounts grouped below for review</small>
          </div>
        </li>
        <li class="checklist__item <%= "checklist__item--done" if Current.user.verified? %>">
          <span aria-hidden="true"><%= Current.user.verified? ? "✓" : "3" %></span>
          <div>
            <strong>Verify your email</strong>
            <small><%= verification_required ? "Required before changing company data" : "Keep account recovery dependable" %></small>
          </div>
        </li>
        <li class="checklist__item <%= "checklist__item--done" if @journal_posted_count.positive? %>">
          <span aria-hidden="true"><%= @journal_posted_count.positive? ? "✓" : "4" %></span>
          <div>
            <strong>Record a business event</strong>
            <small><%= @journal_posted_count.positive? ? "Your ledger is active" : "Owner deposit is the recommended first step" %></small>
          </div>
        </li>
      </ol>
      <details class="starter-chart">
        <summary>Review your starter chart</summary>
        <% @accounts_by_type.each do |type, accounts| %>
          <div class="starter-chart__group">
            <strong><%= type.humanize %></strong>
            <span><%= accounts.map { |account| "#{account.code} · #{account.name}" }.join(", ") %></span>
          </div>
        <% end %>
        <%= link_to "Open full chart", accounts_path(tenant_route_options), class: "text-link" %>
      </details>
    </section>

    <section class="panel">
      <div class="panel__header">
        <div>
          <p class="eyebrow">Activity</p>
          <h2>Recent accounting documents</h2>
        </div>
        <%= link_to "View all", journal_vouchers_path(tenant_route_options), class: "text-link" %>
      </div>
      <% if @documents.any? %>
        <ul class="activity-list">
          <% @documents.each do |document| %>
            <li>
              <%= link_to browser_document_path(document) do %>
                <span>
                  <strong><%= document.document_number || "Draft #{document.doc_type}" %></strong>
                  <small><%= document.narration.presence || "No narration" %></small>
                </span>
                <span class="<%= status_class(document.state) %>"><%= document.state.humanize %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="empty-state empty-state--compact">
          <span class="empty-state__icon" aria-hidden="true">↗</span>
          <h3>No accounting documents yet</h3>
          <p>Your first owner deposit, expense, journal, or opening balance will appear here and feed the reports.</p>
        </div>
      <% end %>
    </section>
  </div>

  <% unless Current.user.verified? %>
    <section id="email-verification" class="panel verification-panel">
      <div>
        <p class="eyebrow"><%= verification_required ? "Required identity step" : "Account recovery" %></p>
        <h2>Verify <%= Current.user.email_address %></h2>
        <p>
          <% case Current.user.verification_delivery_state %>
          <% when "failed" %>
            Delivery failed. Check the address and try again.<%= verification_required ? " You can review existing books, but company changes remain locked until verification." : " You can continue using Folio meanwhile." %>
          <% when "queued", "sending" %>
            The verification email is queued. This page will show when delivery succeeds or fails.<%= " Company changes remain locked until you confirm it." if verification_required %>
          <% when "sent" %>
            The verification email was sent. Open its link within two days.<%= " Company changes remain locked until then." if verification_required %>
          <% else %>
            <%= verification_required ? "Send and confirm a verification email before changing company data." : "Send a verification email so password recovery stays dependable." %>
          <% end %>
        </p>
      </div>
      <div class="verification-panel__action">
        <span class="<%= status_class(Current.user.verification_delivery_state) %>">
          <%= delivery_state_label(Current.user.verification_delivery_state) %>
        </span>
        <% if Current.user.verification_delivery_retryable? %>
          <%= button_to Current.user.verification_delivery_state == "not_sent" ? "Send verification" : "Resend verification",
            verification_delivery_path,
            method: :post,
            params: tenant_route_options,
            class: "button button--secondary" %>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
