<main id="main-content" class="page-shell">
  <%= render "navigation" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow"><%= eyebrow %></p>
      <h1><%= title %></h1>
      <p><%= description %></p>
    </div>
  </header>

  <section class="panel report-filter">
    <%= form_with url: request.path, method: :get, class: "filter-form" do |form| %>
      <%= hidden_field_tag :tenant_id, Current.tenant.id %>
      <div class="form-group"><%= form.label :aged_to, "Age balances to" %>
        <%= form.date_field :aged_to, value: @aged_to.iso8601, required: true %></div>
      <%= form.submit "Run report", class: "button button--secondary" %>
    <% end %>
    <small>This is a current-open-item view aged to the selected date, not a reconstructed historical snapshot.</small>
  </section>

  <% if @aged_report[:rows].any? %>
    <section class="summary-strip" aria-label="Ageing buckets">
      <% Reports::OpenItems::BUCKETS.each do |bucket| %>
        <div>
          <span><%= age_bucket_label(bucket) %></span>
          <strong><%= money_amount(@aged_report.dig(:totals, bucket)) %></strong>
          <small>Outstanding</small>
        </div>
      <% end %>
    </section>

    <section class="panel panel--table">
      <div class="table-wrap"><table>
        <caption class="sr-only"><%= title %> for <%= Current.tenant.name %></caption>
        <thead><tr><th scope="col">Counterparty</th><th scope="col">Document</th>
          <th scope="col">Posting date</th><th scope="col">Due date</th><th scope="col">Age</th>
          <th scope="col">Outstanding</th></tr></thead>
        <tbody>
          <% @aged_report[:rows].each do |row| %>
            <tr>
              <td><strong><%= row[:party_name] %></strong><br><small><%= row[:party_number] %></small></td>
              <td><%= row[:source_document_number] || row[:assignment] %></td>
              <td><%= row[:posting_date].to_fs(:long) %></td>
              <td><%= row[:due_date]&.to_fs(:long) || "—" %></td>
              <td><%= row[:age_days] %> days · <%= age_bucket_label(row[:bucket]) %></td>
              <td class="money"><%= money_amount(row[:outstanding_minor]) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot><tr><th scope="row" colspan="5">Total outstanding</th>
          <td class="money"><%= money_amount(@aged_report[:total_minor]) %></td></tr></tfoot>
      </table></div>
    </section>
  <% else %>
    <section class="panel empty-state">
      <span class="empty-state__icon" aria-hidden="true">✓</span>
      <h2><%= empty_title %></h2>
      <p><%= empty_description %></p>
    </section>
  <% end %>

  <% if @aged_report[:credits].any? %>
    <section class="panel panel--table">
      <div class="page-heading page-heading--compact">
        <div>
          <p class="eyebrow">Unapplied credits</p>
          <h2>Credits available to apply or refund</h2>
          <p>These are opposite-sign open items. Apply one to another document for the same counterparty, or settle it through cash/bank.</p>
        </div>
        <strong><%= money_amount(@aged_report[:credit_total_minor]) %></strong>
      </div>
      <div class="table-wrap"><table>
        <thead><tr><th scope="col">Counterparty</th><th scope="col">Credit</th>
          <th scope="col">Open amount</th><th scope="col">Action</th></tr></thead>
        <tbody>
          <% @aged_report[:credits].each do |credit| %>
            <% targets = @aged_report[:rows].select { |row| row[:party_id] == credit[:party_id] } %>
            <tr>
              <td><strong><%= credit[:party_name] %></strong><br><small><%= credit[:party_number] %></small></td>
              <td><%= credit[:source_document_number] || credit[:assignment] %></td>
              <td class="money"><%= money_amount(credit[:outstanding_minor]) %></td>
              <td>
                <% if permitted?("payments.create") %>
                  <% if targets.any? %>
                    <%= form_with url: net_open_item_credit_path, method: :post, class: "inline-action-form" do |form| %>
                      <%= form.hidden_field :tenant_id, value: Current.tenant.id %>
                      <%= form.hidden_field :role, name: "open_item_credit[role]", value: @aged_report[:role] %>
                      <%= form.hidden_field :credit_entry_line_id, name: "open_item_credit[credit_entry_line_id]", value: credit[:entry_line_id] %>
                      <%= form.hidden_field :applied_on, name: "open_item_credit[applied_on]", value: business_date.iso8601 %>
                      <%= form.select :target_entry_line_id,
                        targets.map { |target| ["#{target[:source_document_number] || target[:assignment]} — #{money_amount(target[:outstanding_minor])}", target[:entry_line_id]] },
                        {}, name: "open_item_credit[target_entry_line_id]", aria: { label: "Open item to credit" } %>
                      <%= form.number_field :amount, name: "open_item_credit[amount]", min: "0.01", step: "0.01",
                        value: money_input_value([credit[:outstanding_minor], targets.first[:outstanding_minor]].min),
                        aria: { label: "Amount to apply" }, required: true %>
                      <%= form.submit "Apply credit", class: "button button--secondary" %>
                    <% end %>
                  <% end %>
                  <%= form_with url: refund_open_item_credit_path, method: :post, class: "inline-action-form" do |form| %>
                    <%= form.hidden_field :tenant_id, value: Current.tenant.id %>
                    <%= form.hidden_field :role, name: "open_item_credit[role]", value: @aged_report[:role] %>
                    <%= form.hidden_field :credit_entry_line_id, name: "open_item_credit[credit_entry_line_id]", value: credit[:entry_line_id] %>
                    <%= form.hidden_field :document_date, name: "open_item_credit[document_date]", value: business_date.iso8601 %>
                    <%= form.select :bank_account_code, @bank_accounts.map { |account| ["#{account.code} · #{account.name}", account.code] },
                      {}, name: "open_item_credit[bank_account_code]", aria: { label: "Cash or bank account" } %>
                    <%= form.number_field :amount, name: "open_item_credit[amount]", min: "0.01", step: "0.01",
                      value: money_input_value(credit[:outstanding_minor]), aria: { label: "Refund amount" }, required: true %>
                    <%= form.submit "Refund credit", class: "button button--secondary" %>
                  <% end %>
                <% else %>
                  <small>Ask a payments user to apply or refund this credit.</small>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    </section>
  <% end %>
</main>
