<% content_for :title, "Day book · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= render "navigation" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow">Operating report</p>
      <h1>Day book</h1>
      <p>Every legal-book entry for <%= @report_entity.legal_name %>, in posting order and <%= @report_entity.functional_currency %>.</p>
    </div>
  </header>

  <section class="panel report-filter">
    <%= form_with url: day_book_report_path, method: :get, class: "filter-form" do |form| %>
      <%= hidden_field_tag :tenant_id, Current.tenant.id %>
      <%= render "entity_field", form: form %>
      <div class="form-group"><%= form.label :from, "From" %><%= form.date_field :from, value: @from_date, required: true %></div>
      <div class="form-group"><%= form.label :to, "To" %><%= form.date_field :to, value: @to_date, required: true %></div>
      <%= form.submit "Run report", class: "button button--secondary" %>
    <% end %>
  </section>

  <section class="summary-strip" aria-label="Day book totals">
    <div><span>Entries</span><strong><%= @day_book[:rows].size %></strong><small>Posted in period</small></div>
    <div><span>Total debit</span><strong><%= money_amount(@day_book[:debit_minor]) %></strong><small>Functional currency</small></div>
    <div><span>Total credit</span><strong><%= money_amount(@day_book[:credit_minor]) %></strong><small>Must equal debit</small></div>
  </section>

  <section class="panel panel--table">
    <div class="table-wrap"><table>
      <caption class="sr-only">Day book from <%= @from_date %> to <%= @to_date %></caption>
      <thead><tr><th scope="col">Posting date</th><th scope="col">Document</th><th scope="col">Description</th>
        <th scope="col">Debit</th><th scope="col">Credit</th></tr></thead>
      <tbody>
        <% @day_book[:rows].each do |row| %>
          <tr>
            <td><%= row[:posting_date].to_fs(:long) %></td>
            <td><strong><%= row[:document_number] || "Entry ##{row[:entry_id]}" %></strong>
              <% if row[:document_type] %><br><small><%= row[:document_type] %> · document date <%= row[:document_date] %></small><% end %></td>
            <td><%= row[:narration].presence || "Posted accounting entry" %>
              <% if row[:party_name] %><br><small><%= row[:party_name] %></small><% end %></td>
            <td class="money"><%= money_amount(row[:debit_minor]) %></td>
            <td class="money"><%= money_amount(row[:credit_minor]) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot><tr><th scope="row" colspan="3">Period total</th>
        <td class="money"><%= money_amount(@day_book[:debit_minor]) %></td>
        <td class="money"><%= money_amount(@day_book[:credit_minor]) %></td></tr></tfoot>
    </table></div>
  </section>
</main>
