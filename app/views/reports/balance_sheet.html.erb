<% content_for :title, "Balance sheet · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= render "navigation" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow">Financial statements</p>
      <h1>Balance sheet</h1>
      <p>Assets, equity, and liabilities for <%= Current.tenant.name %> as at <%= @as_of.to_fs(:long) %>.</p>
    </div>
    <% if permitted?("accounts.manage") && permitted?("documents.post") %>
      <%= link_to "Opening balances", opening_balances_path(tenant_route_options), class: "button button--secondary" %>
    <% end %>
  </header>

  <section class="panel report-filter">
    <%= form_with url: balance_sheet_report_path, method: :get, class: "filter-form" do |form| %>
      <%= hidden_field_tag :tenant_id, Current.tenant.id %>
      <div class="form-group"><%= form.label :as_of, "As at" %>
        <%= form.date_field :as_of, value: @as_of.iso8601, required: true %></div>
      <%= form.submit "Run report", class: "button button--secondary" %>
    <% end %>
    <small>Presentation: <%= @statement.dig(:version, :name) %> · version <%= @statement.dig(:version, :version) %></small>
  </section>

  <%= render layout: "statement_table",
    locals: { statement: @statement, caption: "Balance sheet" } do %>
    <tr class="statement-result">
      <th scope="row"><%= @statement[:difference_minor].zero? ? "Balance check" : "Out of balance" %></th>
      <td class="money"><%= @statement[:difference_minor].zero? ? "Balanced" : money_amount(@statement[:difference_minor]) %></td>
    </tr>
  <% end %>
</main>
