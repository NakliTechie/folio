<% content_for :title, "Profit & loss · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= render "navigation" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow">Financial statements</p>
      <h1>Profit & loss</h1>
      <p>Income and expenses for <%= @report_entity.legal_name %> from <%= @from_date.to_fs(:long) %> to <%= @to_date.to_fs(:long) %>, in <%= @report_entity.functional_currency %>.</p>
    </div>
    <% if permitted?("documents.post") %>
      <%= link_to "Record transaction", new_journal_voucher_path(tenant_route_options), class: "button button--primary" %>
    <% end %>
  </header>

  <section class="panel report-filter">
    <%= form_with url: profit_and_loss_report_path, method: :get, class: "filter-form" do |form| %>
      <%= hidden_field_tag :tenant_id, Current.tenant.id %>
      <%= render "entity_field", form: form %>
      <div class="form-group"><%= form.label :from, "From" %>
        <%= form.date_field :from, value: @from_date.iso8601, required: true %></div>
      <div class="form-group"><%= form.label :to, "To" %>
        <%= form.date_field :to, value: @to_date.iso8601, required: true %></div>
      <%= form.submit "Run report", class: "button button--secondary" %>
    <% end %>
    <small>Presentation: <%= @statement.dig(:version, :name) %> · version <%= @statement.dig(:version, :version) %></small>
  </section>

  <%= render layout: "statement_table",
    locals: { statement: @statement, caption: "Profit and loss statement" } do %>
    <tr class="statement-result">
      <th scope="row"><%= @statement[:net_income_minor].negative? ? "Net loss" : "Net profit" %></th>
      <td class="money"><%= money_amount(@statement[:net_income_minor].abs) %></td>
    </tr>
  <% end %>
</main>
