<% content_for :title, "Trial balance · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= render "navigation" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow">Reports</p>
      <h1>Trial balance</h1>
      <p>Posted legal-book activity for <%= @report_entity.legal_name %>, shown in <%= @report_entity.functional_currency %>.</p>
    </div>
    <% if permitted?("documents.post") %>
      <%= link_to "Record business event", new_journal_voucher_path(tenant_route_options), class: "button button--primary" %>
    <% end %>
  </header>

  <% if @report_entities.many? %>
    <section class="panel report-filter">
      <%= form_with url: report_path, method: :get, class: "filter-form" do |form| %>
        <%= hidden_field_tag :tenant_id, Current.tenant.id %>
        <%= render "entity_field", form: form %>
        <%= form.submit "Run report", class: "button button--secondary" %>
      <% end %>
      <small>Legal books exclude consolidation and elimination layers.</small>
    </section>
  <% end %>

  <% if @plain_outcome %>
    <section class="report-callout" role="status">
      <span aria-hidden="true">✓</span>
      <p>
        <% if @plain_outcome[:kind] == "owner_deposit" %>
          <strong><%= @plain_outcome[:debit_account].name %> increased by <%= money_amount(@plain_outcome[:amount_minor]) %>;</strong>
          <%= @plain_outcome[:credit_account].name %> increased by the same amount.
        <% else %>
          <strong><%= @plain_outcome[:debit_account].name %> increased by <%= money_amount(@plain_outcome[:amount_minor]) %>;</strong>
          <%= @plain_outcome[:credit_account].name %> decreased by the same amount.
        <% end %>
        The affected accounts are highlighted below.
      </p>
    </section>
  <% end %>

  <% if @trial_balance.any? %>
    <section class="summary-strip" aria-label="Account type totals">
      <% @account_type_totals.each do |row| %>
        <div>
          <span><%= row["type"].humanize %></span>
          <% signed_balance = row["debit"] - row["credit"] %>
          <strong><%= money_amount(signed_balance.abs) %></strong>
          <small><%= signed_balance.negative? ? "Credit balance" : signed_balance.positive? ? "Debit balance" : "Zero balance" %></small>
        </div>
      <% end %>
    </section>

    <section class="panel panel--table">
      <% if @highlight_codes.any? && @plain_outcome.nil? %>
        <div class="report-callout" role="status">
          <span aria-hidden="true">✓</span>
          <p><strong>Voucher posted.</strong> The affected accounts are highlighted below.</p>
        </div>
      <% end %>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Trial balance for <%= @report_entity.legal_name %></caption>
          <thead>
            <tr><th scope="col">Account</th><th scope="col">Type</th><th scope="col">Debit</th><th scope="col">Credit</th></tr>
          </thead>
          <tbody>
            <% @trial_balance.each do |row| %>
              <tr class="<%= "table-row--highlight" if @highlight_codes.include?(row["account_id"].to_s) %>">
                <td><span class="account-code"><%= row["account_id"] %></span> <strong><%= row["name"] %></strong></td>
                <td><%= row["type"].humanize %></td>
                <td class="money"><%= money_amount(row["debit"]) %></td>
                <td class="money"><%= money_amount(row["credit"]) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="2">Total</th>
              <td class="money"><%= money_amount(@trial_balance.sum { |row| row["debit"] }) %></td>
              <td class="money"><%= money_amount(@trial_balance.sum { |row| row["credit"] }) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="table-note">A balanced trial balance has equal debit and credit totals. Reversals remain visible through compensating entries.</p>
    </section>
  <% else %>
    <section class="panel empty-state">
      <span class="empty-state__icon" aria-hidden="true">∑</span>
      <h2>Your trial balance is ready for its first entry</h2>
      <p>The starter chart is set up. Post a balanced journal voucher to see account balances here.</p>
      <% if permitted?("documents.post") %>
        <%= link_to "Choose your first business event", new_journal_voucher_path(tenant_route_options),
          class: "button button--primary" %>
      <% end %>
    </section>
  <% end %>
</main>
