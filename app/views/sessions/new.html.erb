<% content_for :title, "Sign in · Folio" %>
<% content_for :description, "Sign in to Folio to manage your company books and accounting records." %>

<main id="main-content" class="auth-shell">
  <section class="auth-intro">
    <p class="eyebrow">Shared accounting, made clear</p>
    <h2>Know where the books stand.</h2>
    <p>Record balanced entries, keep an immutable audit trail, and give every teammate the right level of access.</p>
    <ul class="auth-benefits">
      <li><span aria-hidden="true">✓</span> Guided, balanced journal vouchers</li>
      <li><span aria-hidden="true">✓</span> Trial balance from posted entries</li>
      <li><span aria-hidden="true">✓</span> Role-aware access for your team</li>
    </ul>
  </section>

  <section class="auth-card">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in to Folio</h1>
    <p>Use the email connected to your company.</p>

    <%= form_with url: session_path, class: "stacked-form" do |form| %>
      <div class="form-group">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
      </div>
      <div class="form-group">
        <div class="label-row">
          <%= form.label :password %>
          <%= link_to "Forgot password?", new_password_path %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>
      <%= form.submit "Sign in", class: "button button--primary button--full" %>
    <% end %>

    <p class="auth-card__footer">New to Folio? <%= link_to "Create an account", new_registration_path %></p>
  </section>
</main>
