<% content_for :title, "Increase #{@purchase_bill.document_number} · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= link_to "← Back to purchase bill", purchase_bill_path(@purchase_bill, tenant_route_options), class: "back-link" %>
  <header class="page-heading page-heading--stacked">
    <p class="eyebrow">New supplier debit</p>
    <h1>Increase <%= @purchase_bill.document_number %></h1>
    <p>Enter the supplier's debit-note reference and additional quantities. Rates, GST identity, place of supply, and master snapshots remain tied to the purchase bill.</p>
  </header>

  <%= form_with scope: :purchase_debit_note, url: purchase_debit_notes_path(tenant_route_options), class: "stacked-form" do |form| %>
    <%= form.hidden_field :purchase_bill_id, value: @purchase_bill.id %>
    <section class="panel form-panel">
      <div class="form-grid form-grid--two">
        <div class="form-group"><%= form.label :external_reference, "Supplier debit-note number" %>
          <%= form.text_field :external_reference, maxlength: 100, required: true,
            value: params.dig(:purchase_debit_note, :external_reference), placeholder: "For example, V-DN-1042" %></div>
        <div class="form-group"><%= form.label :document_date, "Supplier debit-note date" %>
          <%= form.date_field :document_date, required: true, min: @purchase_bill.document_date.iso8601,
            value: params.dig(:purchase_debit_note, :document_date).presence || business_date.iso8601 %></div>
        <div class="form-group"><%= form.label :reason_code, "Reason" %>
          <%= form.select :reason_code,
            PurchaseDebitNotes::BuildDraft::REASONS.map { |reason| [debit_note_reason_label(reason), reason] },
            { prompt: "Choose the adjustment reason", selected: params.dig(:purchase_debit_note, :reason_code) },
            required: true %></div>
        <div class="form-group"><%= form.label :narration, "Explanation" %>
          <%= form.text_field :narration, maxlength: 200, required: true,
            value: params.dig(:purchase_debit_note, :narration), placeholder: "Why did the supplier increase this bill?" %></div>
      </div>
    </section>

    <section class="panel panel--table">
      <div class="table-wrap"><table>
        <caption class="sr-only">Purchase-bill lines available to increase</caption>
        <thead><tr><th scope="col">Service</th><th scope="col">Billed</th>
          <th scope="col">Unit price</th><th scope="col">Additional quantity</th></tr></thead>
        <tbody>
          <% @purchase_bill.document_lines.each_with_index do |line, index| %>
            <% submitted = @submitted_lines[index] || {} %>
            <tr>
              <td><strong><%= line.item_snapshot.fetch("name") %></strong><br><small>SAC <%= line.hsn_sac_code %> · <%= basis_points_percentage(line.tax_rate_basis_points) %> GST</small></td>
              <td><%= line.quantity.to_s("F") %> <%= line.item_snapshot.fetch("unitOfMeasure") %></td>
              <td class="money"><%= money_amount(line.unit_price_minor, currency: @purchase_bill.currency) %></td>
              <td><%= hidden_field_tag "purchase_debit_note[lines][][document_line_id]", line.id %>
                <%= label_tag "purchase_debit_note_line_#{line.id}_quantity", "Additional quantity for line #{line.line_no}", class: "sr-only" %>
                <%= number_field_tag "purchase_debit_note[lines][][quantity]",
                  submitted[:quantity] || submitted["quantity"], id: "purchase_debit_note_line_#{line.id}_quantity",
                  min: "0.000001", step: "0.000001", inputmode: "decimal", placeholder: "0" %></td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    </section>

    <div class="balance-note"><span aria-hidden="true">↗</span><p><strong>The preview is immutable.</strong>
      Posting increases expense and input GST and creates a separate open vendor payable.</p></div>
    <div class="form-actions">
      <%= form.submit "Review supplier debit", class: "button button--primary" %>
      <%= link_to "Cancel", purchase_bill_path(@purchase_bill, tenant_route_options), class: "button button--quiet" %>
    </div>
  <% end %>
</main>
