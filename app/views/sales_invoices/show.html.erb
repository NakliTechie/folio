<% content_for :title, "#{@document.document_number || "Draft invoice"} · #{Current.tenant.name} · Folio" %>
<% goods_invoice = @document.contains_goods? %>

<main id="main-content" class="page-shell">
  <%= link_to "← Back to sales invoices", sales_invoices_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow">B2B sales invoice</p>
      <h1><%= @document.document_number || "Draft invoice" %></h1>
      <p><%= @document.party_snapshot.fetch("name") %> · <%= @document.narration.presence || "No invoice note" %></p>
    </div>
    <span class="<%= status_class(@document.state) %>"><%= @document.state.humanize %></span>
  </header>

  <section class="panel voucher-card">
    <dl class="metadata-grid">
      <div><dt>Invoice date</dt><dd><%= @document.document_date.to_fs(:long) %></dd></div>
      <div><dt>Due date</dt><dd><%= @document.due_date.to_fs(:long) %></dd></div>
      <div><dt>Seller GSTIN</dt><dd><%= @document.tax_registration_snapshot.fetch("identifier") %></dd></div>
      <div><dt>Customer GSTIN</dt><dd><%= @document.party_snapshot.fetch("gstin") %></dd></div>
      <div><dt>Place of supply</dt><dd>State <%= @document.place_of_supply_state_code %></dd></div>
      <div><dt>Place-of-supply basis</dt><dd><%= @document.place_of_supply_evidence.fetch("basis").humanize %></dd></div>
      <% if @document.place_of_supply_evidence["reason"].present? %>
        <div><dt>Override evidence</dt><dd><%= @document.place_of_supply_evidence["reason"] %></dd></div>
      <% end %>
      <div><dt>Customer reference</dt><dd><%= @document.external_reference.presence || "—" %></dd></div>
    </dl>

    <div class="table-wrap">
      <table>
        <caption class="sr-only">Frozen sales invoice lines and GST calculation</caption>
        <thead><tr><th scope="col">Service</th><th scope="col">HSN/SAC</th><th scope="col">Quantity</th>
          <th scope="col">Unit price</th><th scope="col">GST rate</th><th scope="col">Taxable</th></tr></thead>
        <tbody>
          <% @document.document_lines.each do |line| %>
            <tr>
              <td><strong><%= line.item_snapshot.fetch("name") %></strong><br><small><%= line.item_snapshot.fetch("code") %></small></td>
              <td><%= line.hsn_sac_code %></td>
              <td><%= line.quantity.to_s("F") %> <%= line.item_snapshot.fetch("unitOfMeasure") %></td>
              <td class="money"><%= money_amount(line.unit_price_minor, currency: @document.currency) %></td>
              <td><%= basis_points_percentage(line.tax_rate_basis_points) %></td>
              <td class="money"><%= money_amount(line.taxable_minor, currency: @document.currency) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr><th scope="row" colspan="5">Subtotal</th><td class="money"><%= money_amount(@document.subtotal_minor, currency: @document.currency) %></td></tr>
          <% @document.tax_breakdown.sort.each do |component, amount| %>
            <tr><th scope="row" colspan="5"><%= component.upcase %></th><td class="money"><%= money_amount(amount, currency: @document.currency) %></td></tr>
          <% end %>
          <tr><th scope="row" colspan="5">Invoice total</th><td class="money"><strong><%= money_amount(@document.total_minor, currency: @document.currency) %></strong></td></tr>
        </tfoot>
      </table>
    </div>
  </section>

  <% unless @document.postable? %>
    <section class="panel posting-panel" aria-labelledby="einvoice-heading">
      <div>
        <p class="eyebrow">GST e-invoice · INV-01 v1.1</p>
        <h2 id="einvoice-heading"><%=
          if @einvoice_cancellation&.cancelled?
            "IRN cancelled"
          elsif @einvoice_cancellation
            "IRN cancellation #{@einvoice_cancellation.status.humanize.downcase}"
          elsif @einvoice_submission&.acknowledged?
            @eway_bill_submission&.generated? ? "IRN and e-way bill acknowledged" : "IRN acknowledged"
          elsif @eway_bill_submission
            "Combined JSON prepared — no IRN or EWB generated"
          elsif @einvoice_submission
            "JSON prepared — IRN not generated"
          elsif goods_invoice
            "Prepare the IRN and e-way bill request"
          else
            "Prepare the IRP request"
          end
        %></h2>
        <% if @einvoice_cancellation&.cancelled? %>
          <p>IRN <strong><%= @einvoice_submission.irn %></strong> was cancelled at <%= @einvoice_cancellation.cancelled_at.to_fs(:long) %>. The statutory cancellation is retained separately from the accounting reversal.</p>
        <% elsif @einvoice_cancellation %>
          <p>Reason <%= @einvoice_cancellation.reason_code %> · <%= @einvoice_cancellation.remarks %>. Do not retry an indeterminate request until the provider is reconciled by IRN.</p>
        <% elsif @einvoice_submission&.acknowledged? %>
          <p>IRN <strong><%= @einvoice_submission.irn %></strong> · acknowledgement <%= @einvoice_submission.ack_number %>. Signature status: <%= @einvoice_submission.signature_status.humanize.downcase %>.</p>
          <% if @eway_bill_submission&.generated? %>
            <p>E-way bill <strong><%= @eway_bill_submission.eway_bill_number %></strong> is valid until <%= @eway_bill_submission.valid_until.to_fs(:long) %>.</p>
          <% end %>
        <% elsif @eway_bill_submission %>
          <p>The immutable INV-01 request includes EWB transport details for combined IRN generation. Folio has not contacted an IRP, generated an IRN, or generated an e-way bill number.</p>
        <% elsif @einvoice_submission %>
          <p>This immutable request is ready for offline upload or a future reviewed provider adapter. Folio has not contacted an IRP, generated an IRN, or verified a signature.</p>
        <% elsif goods_invoice %>
          <p>For an e-invoice-enabled B2B tax invoice, NIC requires the e-way bill to be generated with or by reference to the IRN. Folio freezes both requests together and does not claim a number before provider acknowledgement.</p>
        <% else %>
          <p>Preparation validates the posted invoice against Folio’s domestic B2B INV-01 profile and freezes an idempotent JSON request. It does not contact an IRP.</p>
        <% end %>
      </div>
      <% if @einvoice_submission %>
        <div class="action-row">
          <%= link_to "Download INV-01 JSON", einvoice_json_sales_invoice_path(@document, tenant_route_options),
            class: "button button--secondary" %>
        </div>
      <% elsif goods_invoice && @document.state == "posted" && permitted?("invoices.create") %>
        <%= form_with scope: :eway_bill,
          url: prepare_einvoice_with_eway_sales_invoice_path(@document, tenant_route_options),
          class: "stacked-form" do |form| %>
          <div class="form-grid form-grid--two">
            <div class="form-group">
              <%= form.label :transport_mode, "Transport mode" %>
              <%= form.select :transport_mode,
                Taxes::India::Gst::EwayBill::TRANSPORT_MODES.map { |code, label| [label, code] },
                { selected: "1" }, required: true %>
            </div>
            <div class="form-group">
              <%= form.label :distance_km, "Distance (km)" %>
              <%= form.number_field :distance_km, value: 0, min: 0,
                max: Taxes::India::Gst::EwayBill::MAX_DISTANCE_KM, required: true %>
              <small>Use 0 to request the portal’s PIN-to-PIN distance.</small>
            </div>
            <div class="form-group">
              <%= form.label :vehicle_number, "Vehicle number" %>
              <%= form.text_field :vehicle_number, maxlength: 20,
                placeholder: "For road transport, e.g. MH12AB1234" %>
            </div>
            <div class="form-group">
              <%= form.label :vehicle_type, "Vehicle type" %>
              <%= form.select :vehicle_type,
                Taxes::India::Gst::EwayBill::VEHICLE_TYPES.map { |code, label| [label, code] },
                { selected: "R" }, required: true %>
            </div>
            <div class="form-group">
              <%= form.label :transporter_id, "Transporter GSTIN or TRANSIN (optional)" %>
              <%= form.text_field :transporter_id, maxlength: 15, autocomplete: "off" %>
            </div>
            <div class="form-group">
              <%= form.label :transporter_name, "Transporter name (optional)" %>
              <%= form.text_field :transporter_name, maxlength: 100 %>
            </div>
            <div class="form-group">
              <%= form.label :transport_document_number, "Transport document number" %>
              <%= form.text_field :transport_document_number, maxlength: 15 %>
              <small>Required for rail, air, or ship; optional for road.</small>
            </div>
            <div class="form-group">
              <%= form.label :transport_document_date, "Transport document date" %>
              <%= form.date_field :transport_document_date %>
            </div>
          </div>
          <%= form.submit "Prepare combined IRN + e-way bill JSON", class: "button button--secondary",
            data: { turbo_confirm: "Freeze these INV-01 and e-way transport details together?" } %>
        <% end %>
      <% elsif @document.state == "posted" && permitted?("invoices.create") %>
        <div class="action-row">
          <%= button_to "Prepare e-invoice JSON", prepare_einvoice_sales_invoice_path(@document, tenant_route_options),
            method: :post, class: "button button--secondary",
            form: { data: { turbo_confirm: "Freeze this invoice’s INV-01 request? Reversal will be blocked afterward to avoid IRP ambiguity." } } %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @document.postable? %>
    <section class="panel posting-panel">
      <div>
        <p class="eyebrow">Accounting preview</p>
        <h2><%= @simulation[:balanced] ? "GST calculated and ready to post" : "This invoice does not balance" %></h2>
        <p>Posting debits customer receivables and credits sales plus each typed GST component. The invoice becomes immutable afterward.</p>
      </div>
      <% if @simulation[:balanced] && permitted?("invoices.create") %>
        <%= button_to "Post invoice", post_sales_invoice_path(@document, tenant_route_options),
          method: :post, class: "button button--primary" %>
      <% end %>
    </section>
  <% else %>
    <div class="action-row">
      <% if @document.statutory_printable? %>
        <%= link_to "Print invoice", print_sales_invoice_path(@document, tenant_route_options),
          class: "button button--secondary" %>
      <% end %>
      <% if @document.state == "posted" && permitted?("invoices.create") %>
        <%= link_to "Issue credit note", new_credit_note_path(tenant_route_options.merge(invoice_id: @document.id)),
          class: "button button--secondary" %>
      <% end %>
      <%= link_to "View reports", reports_path(tenant_route_options), class: "button button--primary" if permitted?("reports.read") %>
      <% if @document.reversible? && permitted?("documents.reverse") %>
        <%= button_to "Reverse invoice", reverse_sales_invoice_path(@document, tenant_route_options),
          method: :post, class: "button button--danger",
          form: { data: { turbo_confirm: "Reverse this unsettled invoice with a compensating entry?" } } %>
      <% end %>
    </div>
  <% end %>
</main>
