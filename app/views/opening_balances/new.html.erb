<% content_for :title, "Enter opening balances · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= link_to "← Back to opening balances", opening_balances_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading page-heading--stacked">
    <p class="eyebrow">Period 0</p>
    <h1>Enter opening balances</h1>
    <p>Enter each account on its natural debit or credit side. Total debits must equal total credits.</p>
  </header>

  <%= form_with scope: :opening_balance, url: opening_balances_path(tenant_route_options),
    class: "stacked-form" do |form| %>
    <section class="panel form-panel">
      <div class="form-grid form-grid--two">
        <div class="form-group">
          <%= form.label :posting_date, "Cutover date" %>
          <%= form.date_field :posting_date, required: true,
            value: params.dig(:opening_balance, :posting_date).presence || @default_posting_date.iso8601 %>
          <small>The entry is stored in special period 0 for the fiscal year containing this date.</small>
        </div>
        <div class="form-group">
          <%= form.label :narration, "Description" %>
          <%= form.text_field :narration, maxlength: 200,
            value: params.dig(:opening_balance, :narration), placeholder: "Opening balances at migration" %>
        </div>
      </div>
    </section>

    <section class="panel panel--table opening-balance-grid">
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Debit and credit opening balance input by account</caption>
          <thead><tr><th scope="col">Account</th><th scope="col">Type</th>
            <th scope="col">Debit (<%= Current.tenant.functional_currency %>)</th>
            <th scope="col">Credit (<%= Current.tenant.functional_currency %>)</th></tr></thead>
          <tbody>
            <% @accounts.each do |account| %>
              <tr>
                <td><span class="account-code"><%= account.code %></span> <strong><%= account.name %></strong></td>
                <td><%= account.account_type.humanize %></td>
                <td><%= label_tag "opening_balance_lines_#{account.id}_debit", "Debit for #{account.code}", class: "sr-only" %>
                  <%= number_field_tag "opening_balance[lines][#{account.id}][debit]",
                    @submitted_lines.dig(account.id.to_s, "debit"), id: "opening_balance_lines_#{account.id}_debit",
                    min: 0, step: "0.01", inputmode: "decimal", placeholder: "0.00" %></td>
                <td><%= label_tag "opening_balance_lines_#{account.id}_credit", "Credit for #{account.code}", class: "sr-only" %>
                  <%= number_field_tag "opening_balance[lines][#{account.id}][credit]",
                    @submitted_lines.dig(account.id.to_s, "credit"), id: "opening_balance_lines_#{account.id}_credit",
                    min: 0, step: "0.01", inputmode: "decimal", placeholder: "0.00" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="balance-note">
      <span aria-hidden="true">=</span>
      <p><strong>Nothing posts yet.</strong> Folio validates the balance and shows a complete preview before you confirm.</p>
    </div>
    <div class="form-actions">
      <%= form.submit "Review opening balances", class: "button button--primary" %>
      <%= link_to "Cancel", opening_balances_path(tenant_route_options), class: "button button--quiet" %>
    </div>
  <% end %>
</main>
