<% content_for :title, "#{@contract.contract_number} · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <%= link_to "← Back to contracts", contracts_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading">
    <div>
      <p class="eyebrow"><%= Contract::TYPES.fetch(@contract.contract_type) %></p>
      <h1><%= @contract.contract_number %></h1>
      <p><%= @contract.title %> · <%= @contract.party.name %></p>
    </div>
    <span class="<%= status_class(@contract.status) %>"><%= @contract.status.humanize %></span>
  </header>

  <section class="summary-strip" aria-label="Contract summary">
    <div><small>Contract value</small><strong><%= money_amount(@contract.total_contract_value_minor, currency: @contract.currency) %></strong></div>
    <div><small>Effective</small><strong><%= @contract.effective_date&.to_fs(:long) || "Not set" %></strong></div>
    <div><small>Stated end</small><strong><%= @contract.end_date&.to_fs(:long) || @contract.term_type.humanize %></strong></div>
    <div><small>Notice deadline</small><strong><%= @contract.notice_deadline_date&.to_fs(:long) || "Not set" %></strong></div>
  </section>

  <% if @contract.compliance_flags.any? %>
    <section class="notification" role="status">
      <strong>Evidence review needed</strong>
      <ul><% @contract.compliance_flags.each do |flag| %><li><%= flag %></li><% end %></ul>
    </section>
  <% end %>

  <div class="detail-grid">
    <section class="panel">
      <div class="panel__header"><div><p class="eyebrow">Commercial record</p><h2>Terms</h2></div></div>
      <dl class="summary-list">
        <div><dt>Customer</dt><dd><%= @contract.party.party_number %> · <%= @contract.party.name %></dd></div>
        <div><dt>Accounting treatment</dt><dd>IND AS 115 revenue</dd></div>
        <div><dt>Enforceable period end</dt><dd><%= @contract.enforceable_period_end&.to_fs(:long) || "Not assessed" %></dd></div>
        <div><dt>Renewal</dt><dd><%= @contract.auto_renew? ? "Auto-renewing" : @contract.term_type.humanize %></dd></div>
      </dl>
    </section>

    <section class="panel">
      <div class="panel__header"><div><p class="eyebrow">India record</p><h2>Execution evidence</h2></div></div>
      <dl class="summary-list">
        <div><dt>Signature</dt><dd><%= Contract::SIGNATURE_STATUSES.fetch(@contract.signature_status) %></dd></div>
        <div><dt>Stamping</dt><dd><%= Contract::STAMP_STATUSES.fetch(@contract.stamp_status) %></dd></div>
        <div><dt>Stamp date</dt><dd><%= @contract.stamp_date&.to_fs(:long) || "Not recorded" %></dd></div>
        <div><dt>Registration</dt><dd><%= Contract::REGISTRATION_STATUSES.fetch(@contract.registration_status) %></dd></div>
      </dl>
    </section>
  </div>

  <% if permitted?("contracts.manage") && @contract.status == "draft" %>
    <div class="form-actions"><%= link_to "Edit draft", edit_contract_path(@contract, tenant_route_options), class: "button button--quiet" %></div>
  <% end %>

  <section class="panel">
    <div class="panel__header">
      <div><p class="eyebrow">IND AS 115</p><h2>Performance obligations</h2></div>
      <span class="status"><%= @obligations.size %> identified</span>
    </div>
    <% if @obligations.empty? %>
      <div class="empty-state"><p>No performance obligations have been identified yet.</p></div>
    <% else %>
      <div class="table-wrap"><table>
        <thead><tr><th>PO</th><th>Promise</th><th>Satisfaction</th><th>Standalone price</th><th>Milestones</th></tr></thead>
        <tbody>
          <% @obligations.each do |obligation| %>
            <tr>
              <td>PO <%= obligation.obligation_no %></td>
              <td><strong><%= obligation.description %></strong></td>
              <td><%= obligation.satisfaction.humanize %><% if obligation.progress_measure.present? %><br><small><%= obligation.progress_measure.humanize %></small><% end %></td>
              <td><%= money_amount(obligation.standalone_selling_price_minor, currency: @contract.currency) %></td>
              <td>
                <% if obligation.contract_milestones.empty? %>
                  <span class="muted">None</span>
                <% else %>
                  <ul class="compact-list">
                    <% obligation.contract_milestones.sort_by(&:milestone_no).each do |milestone| %>
                      <li>
                        <%= milestone.description %> · <%= milestone.planned_date.to_fs(:long) %>
                        <span class="<%= status_class(milestone.status) %>"><%= milestone.status.humanize %></span>
                        <% if milestone.status == "planned" && permitted?("contracts.approve") %>
                          <%= form_with url: achieve_milestone_contract_path(@contract, tenant_route_options), method: :post, class: "inline-form" do |form| %>
                            <%= hidden_field_tag :milestone_id, milestone.id %>
                            <%= form.date_field :achieved_date, value: business_date, aria: { label: "Achieved date" }, required: true %>
                            <% if milestone.acceptance_required? %><%= form.date_field :acceptance_date, value: business_date, aria: { label: "Acceptance date" }, required: true %><% end %>
                            <%= form.submit "Achieve", class: "button button--quiet" %>
                          <% end %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    <% end %>

    <% if permitted?("contracts.manage") && @contract.status == "draft" %>
      <details class="disclosure">
        <summary>Add a performance obligation</summary>
        <%= form_with url: create_performance_obligation_contract_path(@contract, tenant_route_options), scope: :performance_obligation, method: :post, class: "stacked-form" do |form| %>
          <div class="field"><%= form.label :description, "Promised good or service" %><%= form.text_field :description, required: true %></div>
          <div class="form-grid">
            <div class="field"><%= form.label :satisfaction %><%= form.select :satisfaction, [["Over time", "over_time"], ["Point in time", "point_in_time"]] %></div>
            <div class="field"><%= form.label :standalone_selling_price, "Standalone selling price" %><%= form.number_field :standalone_selling_price, min: 0, step: 0.01, required: true %></div>
            <div class="field"><%= form.label :ssp_method, "SSP evidence" %><%= form.select :ssp_method, [["Observable price", "observable"], ["Adjusted market", "adjusted_market"], ["Cost plus", "cost_plus"], ["Residual", "residual"]] %></div>
            <div class="field"><%= form.label :progress_measure %><%= form.select :progress_measure, [["Time elapsed (day weighted)", "time_elapsed"]], include_blank: "For point-in-time promises" %></div>
            <div class="field"><%= form.label :service_start_date %><%= form.date_field :service_start_date, value: @contract.effective_date %></div>
            <div class="field"><%= form.label :service_end_date %><%= form.date_field :service_end_date, value: @contract.end_date %></div>
          </div>
          <div class="field"><%= form.label :over_time_criterion, "Why over-time recognition applies" %><%= form.text_field :over_time_criterion %></div>
          <%= form.hidden_field :distinct, value: "1" %><%= form.hidden_field :revenue_account_code, value: "4000" %>
          <%= form.submit "Add obligation", class: "button button--primary" %>
        <% end %>
      </details>

      <% if @obligations.any? { |item| item.satisfaction == "point_in_time" } %>
        <details class="disclosure">
          <summary>Add a point-in-time milestone</summary>
          <%= form_with url: create_milestone_contract_path(@contract, tenant_route_options), scope: :milestone, method: :post, class: "stacked-form" do |form| %>
            <div class="form-grid">
              <div class="field"><%= form.label :obligation_id, "Performance obligation" %><%= form.select :obligation_id, @obligations.select { |item| item.satisfaction == "point_in_time" }.map { |item| ["PO #{item.obligation_no} · #{item.description}", item.id] }, required: true %></div>
              <div class="field"><%= form.label :description %><%= form.text_field :description, required: true %></div>
              <div class="field"><%= form.label :planned_date %><%= form.date_field :planned_date, required: true %></div>
              <div class="field"><%= form.label :recognition_amount %><%= form.number_field :recognition_amount, min: 0, step: 0.01, required: true %></div>
            </div>
            <label class="check-field"><%= form.check_box :acceptance_required %><span>Customer acceptance is required</span></label>
            <%= form.hidden_field :triggers_recognition, value: "1" %>
            <%= form.submit "Add milestone", class: "button button--primary" %>
          <% end %>
        </details>
      <% end %>
    <% end %>
  </section>

  <section class="panel">
    <div class="panel__header"><div><p class="eyebrow">Allocation</p><h2>Transaction price</h2></div></div>
    <% if @latest_allocation %>
      <p>Version <%= @latest_allocation.version %> allocates <%= money_amount(@latest_allocation.transaction_price_minor, currency: @contract.currency) %> using relative standalone selling prices.</p>
      <dl class="summary-list">
        <% @latest_allocation.contract_allocation_lines.sort_by { |line| line.contract_performance_obligation.obligation_no }.each do |line| %>
          <div><dt>PO <%= line.contract_performance_obligation.obligation_no %> · <%= line.contract_performance_obligation.description %></dt><dd><%= money_amount(line.allocated_price_minor, currency: @contract.currency) %></dd></div>
        <% end %>
      </dl>
    <% else %>
      <p>No transaction-price allocation has been recorded.</p>
    <% end %>
    <% if permitted?("contracts.approve") && @obligations.any? && @latest_allocation.nil? %>
      <%= form_with url: allocate_transaction_price_contract_path(@contract, tenant_route_options), method: :post, class: "inline-form" do |form| %>
        <%= form.label :effective_date, "Allocation date" %><%= form.date_field :effective_date, value: business_date, required: true %>
        <%= form.submit "Allocate transaction price", class: "button button--quiet" %>
      <% end %>
    <% elsif @latest_allocation %>
      <small>Allocated terms and promises are frozen. This release uses replacement contracts for modifications.</small>
    <% end %>
  </section>

  <section class="panel panel--table">
    <div class="panel__header">
      <div><p class="eyebrow">Recognition projection</p><h2>Revenue schedules</h2></div>
      <% if permitted?("contracts.approve") && @contract.status == "active" && @latest_allocation %>
        <%= button_to "Generate schedules", generate_revenue_schedules_contract_path(@contract, tenant_route_options), method: :post, class: "button button--quiet" %>
      <% end %>
    </div>
    <% if @schedules.empty? %>
      <div class="empty-state"><p>Activate and allocate the contract, then generate its revenue schedule.</p></div>
    <% else %>
      <div class="table-wrap"><table><thead><tr><th>Version</th><th>PO</th><th>Method</th><th>Status</th><th>Lines</th><th>Total</th></tr></thead><tbody>
        <% @schedules.each do |schedule| %><tr>
          <td>v<%= schedule.version %></td><td>PO <%= schedule.contract_performance_obligation.obligation_no %></td>
          <td><%= schedule.method.humanize %></td><td><span class="<%= status_class(schedule.status) %>"><%= schedule.status.humanize %></span></td>
          <td><%= schedule.contract_schedule_lines.size %></td>
          <td><%= money_amount(schedule.contract_schedule_lines.sum(&:amount_minor), currency: schedule.currency) %></td>
        </tr><% end %>
      </tbody></table></div>
      <% current_lines = @schedules.select { |schedule| schedule.status == "current" }.flat_map(&:contract_schedule_lines).sort_by { |line| [line.due_date, line.sequence] } %>
      <div class="table-wrap"><table><thead><tr><th>Due</th><th>PO</th><th>Amount</th><th>Evidence</th><th>Status</th></tr></thead><tbody>
        <% current_lines.each do |line| %><tr>
          <td><%= line.due_date.to_fs(:long) %></td>
          <td>PO <%= line.contract_schedule.contract_performance_obligation.obligation_no %></td>
          <td><%= money_amount(line.amount_minor, currency: line.contract_schedule.currency) %></td>
          <td><%= line.contract_milestone ? "#{line.contract_milestone.description} · #{line.contract_milestone.status.humanize}" : "Time elapsed" %></td>
          <td><span class="<%= status_class(line.status) %>"><%= line.status.humanize %></span></td>
        </tr><% end %>
      </tbody></table></div>
    <% end %>
  </section>

  <% if permitted?("contracts.post") && @contract.status == "active" && @schedules.any? { |schedule| schedule.status == "current" } %>
    <section class="panel form-panel">
      <div class="panel__header"><div><p class="eyebrow">Controlled posting run</p><h2>Recognize due revenue</h2></div></div>
      <p>Simulation shows the deferred-revenue release and unbilled-receivable split without touching the ledger. Posting writes one idempotent ledger event per eligible schedule line.</p>
      <div class="split-actions">
        <% %w[simulate post].each do |mode| %>
          <%= form_with url: run_revenue_recognition_contract_path(@contract, tenant_route_options), method: :post, class: "inline-form" do |form| %>
            <%= hidden_field_tag :mode, mode %><%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
            <%= form.label :posting_date, mode == "simulate" ? "Through date" : "Posting date" %>
            <%= form.date_field :posting_date, value: business_date, required: true %>
            <%= form.submit mode == "simulate" ? "Simulate due revenue" : "Post due revenue",
              class: mode == "simulate" ? "button button--quiet" : "button button--primary",
              data: (mode == "post" ? { turbo_confirm: "Post every eligible revenue schedule line through this date?" } : {}) %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @posting_runs.any? %>
    <section class="panel panel--table">
      <div class="panel__header"><div><p class="eyebrow">Run evidence</p><h2>Revenue posting history</h2></div></div>
      <div class="table-wrap"><table><thead><tr><th>Created</th><th>Mode</th><th>Through</th><th>Status</th><th>Revenue</th><th>Deferred / unbilled</th></tr></thead><tbody>
        <% @posting_runs.each do |run| %><tr>
          <td><%= run.created_at.to_fs(:long) %></td><td><%= run.mode.humanize %></td><td><%= run.posting_date.to_fs(:long) %></td>
          <td><span class="<%= status_class(run.status) %>"><%= run.status.humanize %></span></td>
          <td><%= money_amount(run.result.fetch("revenue_minor", 0), currency: @contract.currency) %></td>
          <td><%= money_amount(run.result.fetch("contract_liability_minor", 0), currency: @contract.currency) %> / <%= money_amount(run.result.fetch("contract_asset_minor", 0), currency: @contract.currency) %></td>
        </tr><% end %>
      </tbody></table></div>
    </section>
  <% end %>

  <% if permitted?("contracts.approve") %>
    <section class="panel form-panel">
      <div class="panel__header"><div><p class="eyebrow">Governed lifecycle</p><h2>Next transition</h2></div></div>
      <% case @contract.status %>
      <% when "draft" %>
        <%= form_with url: sign_contract_path(@contract, tenant_route_options), method: :post, class: "inline-form" do |form| %>
          <%= form.label :execution_date, "Execution date" %><%= form.date_field :execution_date, value: @contract.execution_date || business_date, required: true %>
          <%= form.submit "Mark signed", class: "button button--primary", data: { turbo_confirm: "Freeze this draft as signed?" } %>
        <% end %>
      <% when "signed" %>
        <%= form_with url: activate_contract_path(@contract, tenant_route_options), method: :post, class: "inline-form" do |form| %>
          <%= form.label :effective_date %><%= form.date_field :effective_date, value: @contract.effective_date || business_date, required: true %>
          <%= form.submit "Activate contract", class: "button button--primary" %>
        <% end %>
      <% when "active" %>
        <%= form_with url: close_contract_path(@contract, tenant_route_options), method: :post, class: "inline-form" do |form| %>
          <%= form.label :closed_on, "Close date" %><%= form.date_field :closed_on, value: business_date, required: true %>
          <%= form.submit "Close contract", class: "button button--quiet", data: { turbo_confirm: "Close this active contract?" } %>
        <% end %>
      <% else %>
        <p>This contract is closed. Its lifecycle and accounting evidence remain immutable.</p>
      <% end %>
    </section>
  <% end %>

  <section class="panel panel--table">
    <div class="panel__header"><div><p class="eyebrow">Hash-chained evidence</p><h2>Lifecycle events</h2></div></div>
    <div class="table-wrap"><table><thead><tr><th>Sequence</th><th>Event</th><th>Recorded</th><th>Actor</th></tr></thead><tbody>
      <% @events.each do |event| %><tr><td><%= event.seq %></td><td><%= event.action.humanize %></td><td><%= event.recorded_at.to_fs(:long) %></td><td><%= event.actor %></td></tr><% end %>
    </tbody></table></div>
  </section>
</main>
