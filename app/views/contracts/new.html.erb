<% content_for :title, "New contract · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell page-shell--narrow">
  <%= link_to "← Back to contracts", contracts_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading page-heading--stacked">
    <p class="eyebrow">Sell-side contract</p>
    <h1>Create a contract</h1>
    <p>Record the commercial, execution, and India-compliance evidence. Folio records stamp facts; it does not calculate authoritative duty.</p>
  </header>
  <section class="panel form-panel">
    <%= render "form", contract: @contract, form_url: contracts_path(tenant_route_options), submit_label: "Create contract draft" %>
  </section>
</main>
