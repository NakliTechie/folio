<% content_for :title, "Transactions · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Transactions</p>
      <h1>Journal vouchers</h1>
      <p>Draft, review, post, and reverse balanced entries without losing their audit trail.</p>
    </div>
    <% if permitted?("documents.post") %>
      <%= link_to "New journal voucher", new_journal_voucher_path(tenant_route_options),
        class: "button button--primary" %>
    <% end %>
  </header>

  <% if @documents.any? %>
    <section class="panel panel--table">
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Journal vouchers for <%= Current.tenant.name %></caption>
          <thead>
            <tr>
              <th scope="col">Voucher</th><th scope="col">Date</th><th scope="col">Narration</th>
              <th scope="col">Amount</th><th scope="col">State</th><th scope="col"><span class="sr-only">Action</span></th>
            </tr>
          </thead>
          <tbody>
            <% @documents.each do |document| %>
              <% debit = document.document_lines.sum { |line| [line.amount_minor, 0].max } %>
              <tr>
                <td><strong><%= document.document_number || "Draft ##{document.id}" %></strong></td>
                <td><%= document.posting_date&.to_fs(:long) %></td>
                <td><%= document.narration.presence || "—" %></td>
                <td class="money"><%= money_amount(debit) %></td>
                <td><span class="<%= status_class(document.state) %>"><%= document.state.humanize %></span></td>
                <td><%= link_to "Open", journal_voucher_path(document, tenant_route_options), class: "text-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <section class="panel empty-state">
      <span class="empty-state__icon" aria-hidden="true">↗</span>
      <h2>No journal vouchers yet</h2>
      <p>Start with a simple debit and credit. Folio previews the balance before posting.</p>
      <% if permitted?("documents.post") %>
        <%= link_to "Record your first transaction", new_journal_voucher_path(tenant_route_options),
          class: "button button--primary" %>
      <% end %>
    </section>
  <% end %>
</main>
