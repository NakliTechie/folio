<% content_for :title, "Account security · Folio" %>

<main id="main-content" class="page-shell">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Account security</p>
      <h1>Signed-in devices</h1>
      <p>Sessions expire after one idle hour or 24 total hours. Revoke anything you do not recognise.</p>
    </div>
  </header>

  <section class="panel">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Sign-in protection</p>
        <h2>Multi-factor authentication</h2>
        <% if Current.user.mfa_enabled? %>
          <p>Enabled <%= time_ago_in_words(Current.user.mfa_enabled_at) %> ago. Authenticator codes or a one-time recovery code are required after your password.</p>
        <% else %>
          <p>Add an authenticator app before production changes are allowed. Setup also creates ten one-time recovery codes.</p>
        <% end %>
      </div>
      <% unless Current.user.mfa_enabled? %>
        <%= button_to "Set up authenticator", mfa_setup_security_path(tenant_route_options),
          class: "button button--primary" %>
      <% end %>
    </div>

    <% if Current.user.mfa_enabled? %>
      <details>
        <summary>Disable multi-factor authentication</summary>
        <%= form_with url: disable_mfa_security_path(tenant_route_options), method: :delete,
          class: "stacked-form" do |form| %>
          <div class="form-group"><%= form.label :password, "Current password" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password" %></div>
          <div class="form-group"><%= form.label :code, "Authenticator or recovery code" %>
            <%= form.text_field :code, required: true, autocomplete: "one-time-code", inputmode: "numeric" %></div>
          <%= form.submit "Disable MFA", class: "button button--danger",
            data: { turbo_confirm: "Disable multi-factor authentication and revoke other sessions?" } %>
        <% end %>
      </details>
    <% end %>
  </section>

  <section class="panel panel--table">
    <div class="panel__header">
      <h2>Active sessions</h2>
      <span class="count-pill"><%= @sessions.size %></span>
    </div>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Active sessions for <%= Current.user.email_address %></caption>
        <thead>
          <tr><th scope="col">Device</th><th scope="col">Last active</th><th scope="col">Expires</th><th scope="col"><span class="sr-only">Action</span></th></tr>
        </thead>
        <tbody>
          <% @sessions.each do |session| %>
            <tr>
              <td>
                <strong><%= session.id == Current.session.id ? "This device" : "Signed-in device" %></strong>
                <small><%= session.user_agent.presence || "Unknown browser" %> · <%= session.ip_address.presence || "Unknown address" %></small>
              </td>
              <td><%= time_ago_in_words(session.last_seen_at) %> ago</td>
              <td><%= l session.expires_at, format: :short %></td>
              <td>
                <%= button_to session.id == Current.session.id ? "Sign out" : "Revoke",
                  active_session_path(session, tenant_route_options), method: :delete,
                  class: "button button--compact button--quiet" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
