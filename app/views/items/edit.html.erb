<% content_for :title, "Edit #{@item.code} · #{Current.tenant.name} · Folio" %>

<main id="main-content" class="page-shell page-shell--narrow">
  <%= link_to "← Back to products & services", items_path(tenant_route_options), class: "back-link" %>
  <header class="page-heading page-heading--stacked">
    <p class="eyebrow">Masters</p>
    <h1>Edit <%= @item.code %></h1>
    <p>Changes affect new drafts only. Posted events keep their resolved classification and amounts.</p>
  </header>
  <section class="panel form-panel">
    <%= render "form", item: @item, form_url: item_path(@item, tenant_route_options),
      submit_label: "Save product or service" %>
  </section>
  <section class="panel lifecycle-panel">
    <div><p class="eyebrow">Lifecycle</p><h2><%= @item.active? ? "Available for new documents" : "Inactive" %></h2>
      <p>Deactivation preserves every historical reference.</p></div>
    <% if @item.active? %>
      <%= button_to "Deactivate item", deactivate_item_path(@item, tenant_route_options), method: :patch,
        class: "button button--danger",
        form: { data: { turbo_confirm: "Deactivate #{@item.code} for new documents?" } } %>
    <% else %>
      <%= button_to "Reactivate item", reactivate_item_path(@item, tenant_route_options), method: :patch,
        class: "button button--secondary" %>
    <% end %>
  </section>
</main>
