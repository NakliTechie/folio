<% content_for :title, "Join #{@invitation.tenant.name} · Folio" %>

<main id="main-content" class="public-form-shell public-form-shell--centered">
  <section class="panel form-panel public-form-card">
    <span class="invitation-mark" aria-hidden="true">✦</span>
    <p class="eyebrow">Team invitation</p>
    <h1>Join <%= @invitation.tenant.name %></h1>
    <p>You were invited as <strong><%= @invitation.role_code.humanize %></strong> using <%= @invitation.email %>.</p>
    <%= form_with url: accept_invitation_path(@token), method: :post, class: "stacked-form" do |f| %>
      <% if @existing_account && Current.user&.email_address == @invitation.email %>
        <div class="inline-note"><p>You’re already signed in with the invited account.</p></div>
      <% else %>
        <div class="form-group">
          <%= f.label :password, @existing_account ? "Confirm your Folio password" : "Choose a password" %>
          <%= f.password_field :password, required: true, autofocus: true,
            autocomplete: @existing_account ? "current-password" : "new-password", maxlength: 72 %>
          <small><%= @existing_account ? "This confirms the invitation belongs to you." : "This creates your Folio sign-in." %></small>
        </div>
      <% end %>
      <%= f.submit "Accept invitation", class: "button button--primary button--full" %>
    <% end %>
  </section>
</main>
